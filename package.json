{
  "name": "razao",
  "private": true,
  "version": "0.0.0",
  "description": "O Razão — gestor financeiro PF e PJ, local e cifrado.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-sw.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check:build": "node scripts/check-build.mjs",
    "check:licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;BSD-2-Clause;BSD-3-Clause;Apache-2.0;ISC;OFL-1.1\"",
    "rastreio": "node scripts/rastreio.mjs",
    "rastreio:sync": "node scripts/sync-requisitos.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format && npm run test:coverage && npm run build && npm run check:build && npm run rastreio",
    "tokens": "node scripts/gen-tokens.mjs",
    "build:hash": "node scripts/build-hash.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "hash-wasm": "4.13.0",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "workbox-build": "7.4.1"
  }
}
